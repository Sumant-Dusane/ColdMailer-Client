{
  "version": "1.0",
  "manifest_version": 3,
  "name": "Cold Mail Assistant",
  "description": "LLM Based Cold Email Extension",
  "action": {
    "default_popup": "index.html"
  },
  "permissions": [
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://mail.google.com/"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/*"
      ],
      "matches": [
        "*://mail.google.com/*"
      ]
    }
  ]
}